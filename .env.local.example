# Copy to .env.local and adjust.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cookie that mirrors the access token so middleware.ts (edge runtime) can
# guard /dashboard/*. Must match between middleware and the auth store.
NEXT_PUBLIC_AUTH_COOKIE=bhbd_token

# Cloudinary unsigned upload (used by the post/avatar uploader in Step 11)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
