# Copy to .env.local and adjust.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cookie that mirrors the access token so middleware.ts (edge runtime) can
# guard /dashboard/*. Must match between middleware and the auth store.
NEXT_PUBLIC_AUTH_COOKIE=bhbd_token

# Google Gemini API Key (for real-time localized business AI Advisor & Assistant)
GEMINI_API_KEY=

# Cloudinary unsigned upload (used by the post/avatar uploader)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
